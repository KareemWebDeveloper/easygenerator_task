# Application Configuration
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database Configuration (Docker local instance)
MONGODB_URI=mongodb://localhost:27017/easygenerator_auth

# Security & JWT Configuration (all secrets are REQUIRED, min 32 chars for JWT secrets)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d
AUTH_COOKIE_NAME=eg_auth_token
REFRESH_COOKIE_NAME=eg_refresh_token
COOKIE_SECRET=replace-with-a-random-secret-of-at-least-16-characters

# Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=10
